# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-with-your-token

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ID администраторов через запятую (для /stats, /broadcast). Узнать свой ID: /id
ADMIN_IDS=

# Путь к файлу SQLite (по умолчанию data/bot.db)
DB_PATH=data/bot.db

# Режим запуска: polling (по умолчанию) или webhook
RUN_MODE=polling

# Настройки webhook (используются при RUN_MODE=webhook)
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=replace-with-random-secret
APP_HOST=0.0.0.0
APP_PORT=8080

# Анти-флуд: минимальный интервал между сообщениями пользователя (секунды, 0 = выкл)
THROTTLE_SECONDS=0.7
